# ============================================================
# 系統超級管理員設定 (Super Admin)
# ============================================================
# 填入您的 LINE User ID (例如: U1234567890abcdef...)，多個可用逗號隔開
SUPER_ADMIN_LINE_IDS=U_your_line_user_id

# ============================================================
# LINE 開發者後台設定 (LINE Developers Console)
# ============================================================
LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token

# ============================================================
# LIFF 設定 (建議在 Vercel 使用不帶 NEXT_ 的變數名稱，以避開限制)
# ============================================================
LINE_LIFF_ID=your_liff_id
LINE_LIFF_URL=https://liff.line.me/your_liff_id

# ============================================================
# Supabase 資料庫設定 (Supabase Project Settings -> API)
# ============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============================================================
# 系統除錯模式 (Debug Mode)
# ============================================================
# 設定為 'on' 時在 LIFF 大廳顯示診斷控制台，預設為 'off' (關閉)
DEBUG=off

# ============================================================
# 快取設定 (Cache Settings)
# ============================================================
# 零打場次記憶體快取時效 (TTL 秒數)，預設為 30 秒。設為 0 可停用快取。
SESSION_CACHE_TTL_SECONDS=30

# ============================================================
# 過期場次自動清理 (Data Retention & Resource Cleanup)
# ============================================================
# 結束時間已超過 N 天的歷史場次與報名記錄將自動從 Supabase 資料庫清除以釋出免費額度。
# 預設為 7 (7天前)，設定為 0 則關閉自動清理（永久保留歷史記錄）。
EXPIRED_SESSION_CLEANUP_DAYS=7

# ============================================================
# 社團場次隔離模式切換 (Cross-Group Sessions Policy)
# ============================================================
# 是否允許球友跨社團/在官方 Bot 1對1私訊中查看所有球團的零打場次：
# - false (預設)：嚴格社團隔離封閉模式。各社團專屬場次僅限本群球友查看，私訊查無特定群組場次時引導回原群報名。
# - true ：全域開放撮合模式。任何管道 (包含私訊與無群組模式) 皆開放檢視全站所有社團的零打場次。
ALLOW_CROSS_GROUP_SESSIONS=false
# (選填相容：若需要亦可設定 NEXT_PUBLIC_ALLOW_CROSS_GROUP_SESSIONS=false，未設定時將自動繼承前者)

